include /etc/sway/config.d/*
include theme

set $mod Mod4

set $up k
set $down j
set $left h
set $right l

# Application
set $term 'ghostty'
set $browser 'flatpak run app.zen_browser.zen'
set $app_menu 'wofi --show drun'
set $bar 'waybar'
set $notifier 'mako'
set $scripts ~/scripts
set $wallpaper ~/bg.png

font pango:FiraCode 14

smart_borders on
default_border pixel
focus_on_window_activation smart

floating_modifier $mod

input type:keyboard {
    repeat_delay 200
    repeat_rate 50
}

input type:touchpad {
    # disables "disable while typing (dwt) allowing the touchpad to be used 
    # whilst pressing keys. Import for gaming. 
    dwt disabled
}

# Wallpaper
output * bg $wallpaper fill

# Quick Launchers
bindsym $mod+Return exec $term
bindsym $mod+n exec $browser
bindsym $mod+space exec $app_menu

bindsym Control+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Ctrl+l exec swaylock -f

# change focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# move focused window
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# toggle tiling / floating
bindsym $mod+Shift+return floating toggle
bindsym $mod+minus split v
bindsym $mod+Bar split h

# Resize Mode
bindsym $mod+Escape mode resize
mode "resize" {
    bindsym $left resize shrink width 10 px
    bindsym $down resize grow height 10 px
    bindsym $up resize shrink height 10 px
    bindsym $right resize grow width 10 px

    bindsym Left resize shrink width 10 px
    bindsym Down resize grow height 10 px
    bindsym Up resize shrink height 10 px
    bindsym Right resize grow width 10 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# Window Rules
assign [app_id="thunderbird"] workspace number 2
assign [title=".*Microsoft Teams"] workspace number 3
assign [title="Newsboat"] workspace number 4
assign [app_id="firefox" title="Apple Music.*"] workspace number 5
for_window [app_id=".*pavucontrol$"] floating enable, sticky enable
for_window [app_id="blueman-manager"] floating enable, sticky enable
for_window [title="Picture-in-Picture"] floating enable, resize set width 640px height 360px
for_window [title=".*1Password$"] floating enable, sticky enable, resize set width 800px height 660px

# switch to workspace
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5

# use top row to make switching workspaces easier on corne
bindsym $mod+q workspace number 1
bindsym $mod+w workspace number 2
bindsym $mod+e workspace number 3
bindsym $mod+r workspace number 4
bindsym $mod+t workspace number 5

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

bindsym $mod+Shift+q move container to workspace number 1
bindsym $mod+Shift+w move container to workspace number 2
bindsym $mod+Shift+e move container to workspace number 3
bindsym $mod+Shift+r move container to workspace number 4
bindsym $mod+Shift+t move container to workspace number 5

## Inputs
### brightness
bindsym XF86MonBrightnessUp exec brightnessctl set '10%+' && $scripts/bright.sh
bindsym XF86MonBrightnessDown exec brightnessctl set '10%-' && $scripts/bright.sh

### audio control
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ && $scripts/wp-vol.sh
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && $scripts/wp-vol.sh

### playerctl
bindsym --locked XF86AudioNext exec playerctl next && notify-send "Audio Next"
bindsym --locked XF86AudioPrev exec playerctl previous && notify-send "Audio Previous"
bindsym --locked XF86AudioPlay exec playerctl play-pause && notify-send "Audio play/pause"
bindsym --locked XF86AudioStop exec playerctl stop && notify-send "Audio Stop"

# screenshots
bindsym $mod+s exec $scripts/screenshot.sh select-file
bindsym $mod+Shift+s exec $scripts/screenshot.sh select-copy

# reload the configuration file
bindsym $mod+Shift+c reload; exec notify-send --app-name "sway" "swaywm Config Reloaded" "~/.config/sway/config reloaded"

# startup programs
exec {
    $notifier
    ~/.local/bin/autotiling-rs
    $bar
    kanshi
    swayidle -w timeout 300 'swaylock -f' timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' lock 'swaylock -f' before-sleep 'swaylock -f'
    wl-paste --watch cliphist store
}

# clipboard history menu
bindsym $mod+p exec cliphist list | wofi -S dmenu | cliphist decode | wl-copy

# windows
bindsym $mod+o exec python $scripts/windows.py

# apps
exec {
    $term
    'gio launch /usr/share/applications/1password.desktop || 1password'
    'gio launch /usr/share/applications/org.mozilla.Thunderbird.desktop || thunderbird'
    '$browser --new-window https://teams.microsoft.com'
    '$term --title=Newsboat -e newsboat'
    '$browser --new-window https://beta.music.apple.com/gb/home'
}
